{
  "_comment": "Permissions for pod-Claude running INSIDE the RunPod pod. Generated/copied to /workspace/lyra/.claude/settings.local.json on first pod boot by bootstrap.sh.",
  "permissions": {
    "allow": [
      "Read(/workspace/**)",
      "Write(/workspace/lyra/**)",
      "Edit(/workspace/lyra/**)",
      "Write(/workspace/outputs/**)",
      "Edit(/workspace/outputs/**)",

      "mcp__knowledge-base__kb_search",
      "mcp__knowledge-base__kb_search_smart",
      "mcp__knowledge-base__kb_context",
      "mcp__knowledge-base__kb_read",
      "mcp__knowledge-base__kb_list",
      "mcp__knowledge-base__kb_vault_status",
      "mcp__notebooklm-mcp__notebook_list",
      "mcp__notebooklm-mcp__notebook_query",
      "mcp__notebooklm-mcp__notebook_query_start",
      "mcp__notebooklm-mcp__notebook_query_status",
      "mcp__notebooklm-mcp__source_describe",
      "mcp__notebooklm-mcp__source_get_content",
      "Glob",
      "Grep",
      "WebSearch",
      "WebFetch",

      "Bash(source /workspace/activate.sh*)",
      "Bash(conda*)",
      "Bash(pip*)",
      "Bash(python*)",
      "Bash(ls*)",
      "Bash(cat*)",
      "Bash(grep*)",
      "Bash(find*)",
      "Bash(which*)",
      "Bash(echo*)",
      "Bash(printf*)",
      "Bash(env)",
      "Bash(printenv*)",
      "Bash(nvidia-smi*)",
      "Bash(df*)",
      "Bash(du*)",
      "Bash(free*)",
      "Bash(top*)",
      "Bash(ps*)",
      "Bash(nvcc*)",

      "Bash(git status*)",
      "Bash(git log*)",
      "Bash(git diff*)",
      "Bash(git branch*)",
      "Bash(git fetch*)",
      "Bash(git checkout*)",
      "Bash(git pull*)",
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(git push origin voxelo/main*)",
      "Bash(git push origin voxelo/*)",
      "Bash(git remote*)",

      "Bash(bash /workspace/lyra/scripts/bootstrap.sh*)",
      "Bash(./scripts/bootstrap.sh*)",
      "Bash(scripts/bootstrap.sh*)",

      "Bash(huggingface-cli download*)",
      "Bash(huggingface-cli scan-cache*)",
      "Bash(huggingface-cli whoami)",

      "Bash(apt list --installed*)",
      "Bash(dpkg -l*)"
    ],
    "deny": [
      "Bash(git push origin main*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(rm -rf /workspace/miniconda3*)",
      "Bash(rm -rf /workspace/envs*)",
      "Bash(rm -rf /workspace/weights*)",
      "Bash(apt remove*)",
      "Bash(apt purge*)"
    ]
  }
}
